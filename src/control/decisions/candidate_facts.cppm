    CandidateFieldSpec{"workflow.work_complete", state_tree::Type::Boolean, CandidateGroup::workflow}};
inline constexpr std::array<std::string_view, 41> objective_field_names{"active",
                                                                        "reached",
                                                                        "x",
                                                                        "y",
                                                                        "revision",
                                                                        "id",
                                                                        "directive",
                                                                        "behavior",
