inline std::optional<CandidateField> compile_candidate_field(std::string_view name)
{
	for (std::size_t i = 0; i < candidate_field_specs.size(); ++i)
		if (candidate_field_specs[i].name == name)
			return static_cast<CandidateField>(i);
	return {};
}
inline std::optional<ObjectiveField> compile_objective_field(std::string_view name)
{
	for (std::size_t i = 0; i < objective_field_names.size(); ++i)
		if (objective_field_names[i] == name)
			return static_cast<ObjectiveField>(i);
	return {};
}
struct CandidateFacts : std::map<CandidateField, state_tree::Value>
{
	using std::map<CandidateField, state_tree::Value>::map;
	std::map<std::size_t, state_tree::Value> bound;
	void set_bound(std::size_t slot, state_tree::Value value)
	{
		bound[slot] = std::move(value);
	}
};
using ObjectiveFacts = CandidateFacts;
enum class CandidateSource : std::size_t
{
	single,
	medical,
	craft,
	requests,
	away,
	repair,
	contacts,
	armament,
	scans,
	reports,
	docks,
	personnel,
	delivery
};
inline CandidateSource compile_candidate_source(std::string_view name)
{
	constexpr std::array<std::string_view, 13> names{"single", "medical",   "craft",    "requests", "away",
	                                                 "repair", "contacts",  "armament", "scans",    "reports",
	                                                 "docks",  "personnel", "delivery"};
	for (std::size_t i = 0; i < names.size(); ++i)
		if (names[i] == name)
			return static_cast<CandidateSource>(i);
	return CandidateSource::single;
}
