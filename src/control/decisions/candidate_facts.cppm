    CandidateFieldSpec{"workflow.opening_fire", state_tree::Type::Boolean, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.phase", state_tree::Type::Text, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.port", state_tree::Type::Text, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.ship_transport", state_tree::Type::Boolean, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.stopping_distance", state_tree::Type::Integer, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.target_distance", state_tree::Type::Integer, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.travel_distance", state_tree::Type::Integer, CandidateGroup::workflow},
    CandidateFieldSpec{"workflow.travelling", state_tree::Type::Boolean, CandidateGroup::workflow},
