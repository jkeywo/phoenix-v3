# Fail configuration if a frontend acquires authoritative code transitively.
function(phoenix_forbid_dependency target forbidden visited)
  if("${target}" STREQUAL "${forbidden}")
    message(FATAL_ERROR "Forbidden link dependency: ${forbidden} (via ${visited})")
  endif()
  if(NOT TARGET "${target}" OR "${target}" IN_LIST visited)
    return()
  endif()
  list(APPEND visited "${target}")
  foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(dependencies "${target}" "${property}")
    if(dependencies)
      foreach(dependency IN LISTS dependencies)
        if(dependency MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
          set(dependency "${CMAKE_MATCH_1}")
        endif()
        phoenix_forbid_dependency("${dependency}" "${forbidden}" "${visited}")
      endforeach()
    endif()
  endforeach()
endfunction()
