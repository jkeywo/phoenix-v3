root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[references/**]
charset = unset
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
